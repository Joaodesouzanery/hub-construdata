# ==============================================================
# Hub ConstruData — Variaveis de Ambiente
# ==============================================================
#
# Como configurar:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha com seus dados do Supabase (veja abaixo)
#   3. Rode: npm run dev
#
# Onde encontrar esses valores:
#   - Va em https://supabase.com/dashboard
#   - Selecione seu projeto
#   - Va em Settings > API
#   - "Project URL" = VITE_SUPABASE_URL
#   - "anon public" key = VITE_SUPABASE_ANON_KEY
#
# SEGURANCA:
#   - A chave "anon public" e segura para o frontend (usada com RLS)
#   - NUNCA coloque a "service_role" key aqui ou no frontend
#   - Este arquivo (.env) esta no .gitignore e NAO vai para o repositorio
# ==============================================================

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.SUA_CHAVE_AQUI
